            "taxRate": {
              "$ref": "#/$defs/decimalRule"
            },
            "pricesIncludeTax": {
              "$ref": "#/$defs/booleanRule"
            },
            "serviceChargeDefault": {
              "$ref": "#/$defs/decimalRule"
            },
            "taxOnServiceCharge": {
              "$ref": "#/$defs/booleanRule"
            },
            "tipPresets": {
              "$ref": "#/$defs/decimalListRule"
            },
            "tipDefault": {
              "$ref": "#/$defs/decimalRule"
            },
            "tipOnPreTax": {
              "$ref": "#/$defs/booleanRule"
            },
            "cashRounding": {
              "$ref": "#/$defs/cashRoundingRule"
            },
            "denominations": {
              "$ref": "#/$defs/denominationsRule"
            },
            "electricityRate": {
              "$ref": "#/$defs/decimalRule"
            },
            "overtime": {
              "$ref": "#/$defs/overtimeRule"
            },
            "taxRegistrationThreshold": {
              "$ref": "#/$defs/thresholdRule"
            },
            "percentageTax": {
              "$ref": "#/$defs/decimalRule"
            },
            "withholdingTax.monthly": {
              "$ref": "#/$defs/bracketsRule"
            },
            "incomeTax.graduated": {
              "$ref": "#/$defs/bracketsRule"
            },
            "payments.providers": {
              "$ref": "#/$defs/paymentProvidersRule"
            },
            "payments.surcharge": {
              "$ref": "#/$defs/paymentSurchargeRule"
            },
            "payments.withholding": {
              "$ref": "#/$defs/paymentWithholdingRule"
            }
          },
          "patternProperties": {
            "^mealTax\\.[a-z]{2}$": {
              "$ref": "#/$defs/mealTaxRule"
            },
            "^provincialOvertime\\.[a-z]+$": {
              "$ref": "#/$defs/provincialOvertimeRule"
            },
            "^vacationPay\\.[a-z]+$": {
              "$ref": "#/$defs/vacationPayRule"
            },
            "^delivery\\.(?!apps$|taxes$|withholding$|cityCaps$|baseTier$)[a-z][A-Za-z0-9]*$": {
              "$ref": "#/$defs/deliveryAppRule"
            },
            "^delivery\\.taxes$": {
              "$ref": "#/$defs/deliveryTaxesRule"
            },
            "^delivery\\.cityCaps$": {
              "$ref": "#/$defs/deliveryCityCapsRule"
            },
            "^minimumWage\\.(nb|nl|federal)$": {
              "$ref": "#/$defs/decimalRule"
            },
            "^payments\\.(terminal|online)\\.[A-Za-z][A-Za-z0-9]*$": {
              "$ref": "#/$defs/paymentProviderRule"
            },
            "^opening\\.guide$": {
              "$ref": "#/$defs/openingGuideRule"
            },
            "^opening\\.permits$": {
              "$ref": "#/$defs/openingPermitsRule"
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/schedule"
          },
          "propertyNames": {
            "pattern": "^[A-Za-z][A-Za-z0-9]*(\\.[A-Za-z][A-Za-z0-9]*)*$"
          }
        }
      }
    }
